# Settings for the API container (docker compose reads deploy/api.env; on Fly.io set the
# secret ones with `fly secrets set`).

# "clerk": people sign in with Google through Clerk and each has their own data.
# "local": one user and no real sign-in. Only for a container on your own machine.
AUTH_MODE=clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where the web app is served from (comma separated). Only these pages may call the API.
ALLOWED_ORIGINS=http://localhost:5173

# false: Submit records the application but never sends it. true: Submit really applies.
SUBMIT_REAL_FORM=false
# Optional. With a key, Claude drafts answers (for every user, on this key).
ANTHROPIC_API_KEY=
# How many browsers may fill or submit at once, across all users.
MAX_CONCURRENT_RUNS=2
# true: only the fakecompany test links work and they open a test form inside the container.
FAKE_GREENHOUSE=false

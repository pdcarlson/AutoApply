# Dev server defaults. Override any of these in .env.development.local (git-ignored).

# Base path of the backend API. Requests go to `${VITE_API_BASE_URL}/...`.
VITE_API_BASE_URL=/api

# `enabled` serves every /api request from the in-browser mock API in src/mocks (dev only).
VITE_API_MOCKING=enabled

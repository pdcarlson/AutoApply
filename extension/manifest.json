{
  "manifest_version": 3,
  "name": "AutoApply Filler",
  "version": "0.1.0",
  "description": "Fills a job application in your own browser with the answers AutoApply prepared. You review it and press Submit yourself.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8080/*", "http://127.0.0.1:8080/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://jobs.lever.co/*"],
      "js": ["fill.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}

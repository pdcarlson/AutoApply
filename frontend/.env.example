# Copy to .env.local (git-ignored) and fill in your own values.
# `npm run dev` and `npm run build` both read .env.local.

# Where the backend API lives.
VITE_API_BASE_URL=https://<your-api-host>/api

# Clerk's publishable key. The app shows an error instead of starting without it.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
